# Copy this file to .env (in this same directory) and fill in real values.
# .env is gitignored at the repo root.

# --- OpenSearch (used by ingest.py + evaluate_answer.py) ---
# Leave OPENSEARCH_HOST blank to skip live retrieval entirely --
# evaluate_answer.py will fall back to its built-in sample context.
OPENSEARCH_HOST=your-cluster-host.instaclustr.com
OPENSEARCH_PORT=9200
OPENSEARCH_USER=your-username
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_SSL=true
OPENSEARCH_INDEX=opensearchcon-eval-chunks

# --- Embeddings (defaults are fine for most machines) ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSION=384

# --- Local LLM runtime (shared with the other demos) ---
# LLM_RUNTIME=mlx
# LLAMA_MODEL_PATH=~/models/Qwen2.5-7B-Instruct-1M-Q5_K_M.gguf
# MLX_MODEL_PATH=~/models/Qwen2.5-7B-Instruct-1M-4bit
