# Copy this file to .env and fill in real values. .env is gitignored.

# --- Instaclustr OpenSearch ---
OPENSEARCH_HOST=your-cluster-host.instaclustr.com
OPENSEARCH_PORT=9200
OPENSEARCH_USER=icopensearch
OPENSEARCH_PASSWORD=
OPENSEARCH_SSL=true

# --- Amazon Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# --- Index names ---
# Sections 1/2
OPENSEARCH_VECTOR_RECIPES_BASELINE_INDEX=recipes-vector-baseline
OPENSEARCH_BM25_RECIPES_BASELINE_INDEX=recipes-bm25-baseline
# Sections 3/4
OPENSEARCH_HYBRID_INDEX=recipes-hybrid
OPENSEARCH_RECIPE_BM25_INDEX=recipes-bm25
OPENSEARCH_RECIPE_VECTOR_INDEX=recipes-vector

# --- Embeddings / NER ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
NER_SERVICE_URL=http://127.0.0.1:8000/ner

# --- Vector index construction ---
# These defaults work on any OpenSearch cluster with the k-NN plugin.
# See GPU.md before changing them.
VECTOR_ENGINE=lucene
VECTOR_SPACE_TYPE=l2
KNN_NUMBER_OF_SHARDS=1
KNN_NUMBER_OF_REPLICAS=0

# Reconstruct vectors on read instead of storing them raw in _source. Saves
# a lot of space on large indexes, but it is irrelevant at the 260-recipe
# sample size and has been seen to break _source reads on a faulty node, so
# it is off by default.
KNN_DERIVED_SOURCE=false

# Offload vector index construction to a GPU build service. Requires a
# cluster with the service configured -- see GPU.md. Inert without one.
KNN_REMOTE_BUILD=false
KNN_REMOTE_BUILD_SIZE_MIN=50mb
# 0 forces HNSW graph construction regardless of doc count. The OpenSearch
# default is 15000, below which no graph (and so no remote build) happens.
KNN_APPROXIMATE_THRESHOLD=0

# --- Section 3 hybrid fusion ---
# A document matched only by BM25 can never score above HYBRID_BM25_WEIGHT.
# On the 260-recipe sample 0.3 is plenty; on the full corpus thousands of
# recipes clear 0.3 on vector similarity alone and bury the named recipe.
HYBRID_BM25_WEIGHT=0.6
HYBRID_VECTOR_WEIGHT=0.4
# How deep each sub-query is searched before the two lists are fused. Must be
# larger than RAG_TOP_K or the combiner never sees the documents it needs.
HYBRID_CANDIDATE_K=50

# --- Ingest ---
# Refresh is disabled during bulk load and restored afterwards.
INGEST_REFRESH_INTERVAL=-1
INGEST_BULK_BATCH_SIZE=500
